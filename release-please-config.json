{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/refs/heads/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "ghost-loader": {
      "release-type": "node",
      "extra-files": [
        {
          "type": "json",
          "path": "deno.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "git-repo-loader": {
      "release-type": "node",
      "extra-files": [
        {
          "type": "json",
          "path": "deno.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
